DATABASE_URL="postgresql://toonymous_user:toonymous_dev_pw@localhost:5433/toonymous?schema=public"
REDIS_URL="redis://localhost:6379/1"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-value"
PORT=4001
FRONTEND_ORIGIN="http://localhost:4000"
BACKEND_ORIGIN="http://localhost:4001"
CARTOONIZER_URL="http://127.0.0.1:4002"
NODE_ENV="development"

# Optional, only needed on a host with no persistent disk (e.g. the free-tier
# demo deploy, see specs/04-conventions.md) - cartoonized images are stored
# in Supabase Storage instead of locally when all three are set.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# Optional, only needed when the cartoonizer can't stay off the public
# internet (no private-service option on the host) - sent as a header to
# the cartoonizer, which rejects requests without it when set there too.
CARTOONIZER_SHARED_SECRET=
