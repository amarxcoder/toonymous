PORT=3082

# Which cartoonize engine to use: sharp | gmic | api
# sharp - lightweight image filter, no extra installs, works everywhere (default)
# gmic  - real cartoon filter via the `gmic` CLI (`sudo apt install gmic`), no GPU needed
# api   - passthrough to an external service (local model server or hosted API)
CARTOONIZE_PROVIDER=gmic

# Only used when CARTOONIZE_PROVIDER=api
CARTOONIZE_API_URL=
CARTOONIZE_API_KEY=
