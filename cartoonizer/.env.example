PORT=4002

# Which cartoonize engine to use: sharp | onnx | gmic | api
# sharp - lightweight image filter, no extra installs, works everywhere (default)
# onnx  - AnimeGANv2 model on CPU (used by the demo deploy). Also export
#         MALLOC_MMAP_THRESHOLD_=1048576 in the shell before starting; it has no
#         effect from this file, and without it memory climbs per image.
# gmic  - real cartoon filter via the `gmic` CLI (`sudo apt install gmic`), no GPU needed
# api   - passthrough to an external service (local model server or hosted API)
CARTOONIZE_PROVIDER=gmic

# Only used when CARTOONIZE_PROVIDER=api
CARTOONIZE_API_URL=
CARTOONIZE_API_KEY=

# Optional. Defaults to 127.0.0.1 (internal only, correct for a real VPS
# where nginx and this process share a host). A container-based free host
# needs HOST=0.0.0.0 to be reachable at all - see specs/04-conventions.md.
HOST=

# Optional, pairs with the same var on the backend - see backend/.env.example.
CARTOONIZER_SHARED_SECRET=
